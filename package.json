{
  "name": "session-manager",
  "displayName": "N100 Session Manager",
  "description": "ChatGPT-style rich AI chat & web terminal for active tmux and agy sessions in Antigravity IDE",
  "version": "1.3.16",
  "publisher": "ttolmany",
  "repository": {
    "type": "git",
    "url": "https://github.com/jkeolham/session-manager"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "scripts": {
    "serve": "node server.mjs",
    "test": "node test/test-server-api.js && node test/test-server-stream.js && node test/test-mobile-ui-assets.js"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:sessionManagerView",
    "onView:sessionPromptComposerView",
    "onCommand:sessionManager.sendPrompt",
    "onCommand:sessionManager.focusComposer",
    "onCommand:sessionManager.openSessionPanel"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionManagerContainer",
          "title": "Sessions",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "sessionManagerContainer": [
        {
          "id": "sessionManagerView",
          "name": "N100 Sessions"
        },
        {
          "type": "webview",
          "id": "sessionPromptComposerView",
          "name": "Prompt Composer (채팅창 입력기)"
        }
      ]
    },
    "commands": [
      {
        "command": "sessionManager.openSessionPanel",
        "title": "Open Session (AI Chat & Terminal)",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sessionManager.attach",
        "title": "Attach to Session",
        "icon": "$(terminal)"
      },
      {
        "command": "sessionManager.attachRemoteControl",
        "title": "Attach Remote Control Session",
        "icon": "$(radio-tower)"
      },
      {
        "command": "sessionManager.refresh",
        "title": "Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "sessionManager.newAgy",
        "title": "New AGY Session",
        "icon": "$(add)"
      },
      {
        "command": "sessionManager.kill",
        "title": "Kill Session",
        "icon": "$(trash)"
      },
      {
        "command": "sessionManager.reloadRemoteControl",
        "title": "Reload Session (Sync Latest Turns)",
        "icon": "$(sync)"
      },
      {
        "command": "sessionManager.deleteRemoteControl",
        "title": "Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "sessionManager.sendPrompt",
        "title": "Send Prompt (GUI Input)",
        "icon": "$(comment)"
      },
      {
        "command": "sessionManager.focusComposer",
        "title": "Focus Prompt Composer",
        "icon": "$(edit)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sessionManager.refresh",
          "when": "view == sessionManagerView",
          "group": "navigation@1"
        },
        {
          "command": "sessionManager.sendPrompt",
          "when": "view == sessionManagerView",
          "group": "navigation@2"
        },
        {
          "command": "sessionManager.newAgy",
          "when": "view == sessionManagerView",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "sessionManager.sendPrompt",
          "when": "viewItem == remoteControlItem || viewItem == sessionItem",
          "group": "inline@0"
        },
        {
          "command": "sessionManager.reloadRemoteControl",
          "when": "viewItem == remoteControlItem",
          "group": "inline@1"
        },
        {
          "command": "sessionManager.deleteRemoteControl",
          "when": "viewItem == remoteControlItem",
          "group": "inline@2"
        },
        {
          "command": "sessionManager.attach",
          "when": "viewItem == sessionItem",
          "group": "inline@1"
        },
        {
          "command": "sessionManager.kill",
          "when": "viewItem == sessionItem",
          "group": "inline@2"
        }
      ],
      "terminal/context": [
        {
          "command": "sessionManager.sendPrompt",
          "group": "0_navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sessionManager.sendPrompt",
        "key": "alt+i",
        "mac": "cmd+alt+i"
      }
    ]
  },
  "icon": "media/icon.png",
  "keywords": [
    "antigravity",
    "tmux",
    "session-manager",
    "claude",
    "terminal",
    "sessions"
  ]
}